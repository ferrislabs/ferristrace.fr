---
import Base from '../layouts/base.astro'
import { ChangelogPage, LEAD } from '../components/changelog'
import { readReleases } from '../lib/changelog-source'

const { releases, origin } = await readReleases()
---

<Base
  title="Changelog"
  description={LEAD}
  canonical="/changelog"
  thumbnail="/thumbnail.png"
>
  <ChangelogPage releases={releases} isExample={origin === 'example'} client:load />
</Base>
