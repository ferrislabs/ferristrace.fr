---
import Base from '../layouts/base.astro'
import { NotFoundPage } from '../components/not-found'
import { readRepoStats } from '../lib/repo-stats'

const stats = await readRepoStats()
---

<Base
  title="Page not found · FerrisTrace"
  description="Nothing lives at this address."
  robots="noindex"
>
  <NotFoundPage stars={stats?.stars} client:load />
</Base>
