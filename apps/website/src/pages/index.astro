---
import { closeSync, existsSync, openSync, readSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import Base from '../layouts/base.astro'
import { Landing } from '../components/landing'
import { readReleases } from '../lib/changelog-source'
import { readRepoStats } from '../lib/repo-stats'

/**
 * Drop the trace view screenshots in public/screenshots/ and they replace the
 * placeholder on the next build. Width and height come from the file itself so
 * the frame reserves the right height before the image loads.
 */
const shot = (name: string) => {
  const src = `/screenshots/${name}`
  const file = fileURLToPath(new URL(`../../public${src}`, import.meta.url))
  if (!existsSync(file)) return undefined

  // PNG: an 8-byte signature, then the IHDR chunk, whose width and height sit
  // at byte 16 and 20 as big-endian uint32.
  const head = Buffer.alloc(24)
  const fd = openSync(file, 'r')
  readSync(fd, head, 0, 24, 0)
  closeSync(fd)

  return { src, width: head.readUInt32BE(16), height: head.readUInt32BE(20) }
}

// Empty until a real CHANGELOG.md exists, which drops "Recently shipped"
// out of the page entirely. readReleases no longer has a fixture to fall
// back to, so nothing made up can reach it.
const { releases } = await readReleases()
const stats = await readRepoStats()
---

<Base
  title="FerrisTrace"
  description="Traces, logs and metrics for your services. Open source, self-hosted, OpenTelemetry native."
  canonical="/"
>
  <Landing
    shotLight={shot('trace-light.png')}
    shotDark={shot('trace-dark.png')}
    releases={releases}
    stats={stats}
    client:load
  />
</Base>
