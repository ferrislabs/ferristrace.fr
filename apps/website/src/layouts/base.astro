---
import '../styles/globals.css'
import { ClientRouter } from 'astro:transitions'
import { formatTitle } from '@ferristrace/config'
import { siteConfig } from '../config'

interface Props {
  title: string
  description?: string
  thumbnail?: string
  /** Path or absolute URL of the canonical page, e.g. "/changelog". */
  canonical?: string
  /** Robots directive, e.g. "noindex" for pages that must stay out of search. */
  robots?: string
}

const { title, description, thumbnail, canonical, robots } = Astro.props
// Only with a configured site: a canonical pointing at localhost is worse
// than none at all.
const canonicalUrl = canonical && Astro.site ? new URL(canonical, Astro.site).href : undefined

/**
 * Social cards are fetched by Slack, X and LinkedIn from their own servers, so
 * the image has to be an absolute URL. A path resolves against nothing there
 * and the card comes out blank, which is how this shipped before.
 */
const thumbnailPath = thumbnail ?? siteConfig.thumbnail
const thumbnailUrl = Astro.site ? new URL(thumbnailPath, Astro.site).href : thumbnailPath

/** Every card in public/og is drawn at this size. Declaring it lets a platform
 *  lay the card out before it has finished downloading the image. */
const THUMBNAIL_SIZE = { width: '1200', height: '630' }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="description" content={description ?? siteConfig.description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? siteConfig.description} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:image:width" content={THUMBNAIL_SIZE.width} />
    <meta property="og:image:height" content={THUMBNAIL_SIZE.height} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={siteConfig.ogType} />
    <meta name="twitter:card" content={siteConfig.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? siteConfig.description} />
    <meta name="twitter:image" content={thumbnailUrl} />
    <title>{formatTitle(siteConfig, title)}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
        document.documentElement.classList.toggle('light', !isDark)
      })()
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
        document.documentElement.classList.toggle('light', !isDark)
      })
    </script>
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <slot />
  </body>
</html>
