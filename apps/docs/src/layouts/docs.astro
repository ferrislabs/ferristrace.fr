---
import '../styles/globals.css'
import { ClientRouter, ViewTransitions } from 'astro:transitions'
import { Header } from '../components/header'
import { Sidebar } from '../components/sidebar'
import { TableOfContents, type TocHeading } from '../components/toc'
import { formatTitle } from '@cometrace/config'
import { Pagination } from '../components/pagination'
import { Footer } from '../components/footer'
import { siteConfig } from '../config'
import type { NavItem, ProjectInfo, BreadcrumbItem } from '../lib/docs'
import { AuthGate } from '@cometrace/auth/react'
import NotFoundContent from '../components/not-found-content.astro'

interface Props {
  title: string
  description?: string
  headings: TocHeading[]
  navItems: NavItem[]
  currentPath: string
  prev: { title: string; href: string } | null
  next: { title: string; href: string } | null
  projects: ProjectInfo[]
  currentProject: string
  currentVersion: string
  currentLocale: string
  locales: string[]
  projectSwitchUrls: Record<string, string>
  versionSwitchUrls: Record<string, string>
  localeSwitchUrls: Record<string, string>
  breadcrumb: BreadcrumbItem[]
  thumbnail?: string
  requiresAuth?: boolean
  requiredRoles?: string[]
}

const {
  title,
  description,
  headings,
  navItems,
  currentPath,
  prev,
  next,
  projects,
  currentProject,
  currentVersion,
  currentLocale,
  locales,
  projectSwitchUrls,
  versionSwitchUrls,
  localeSwitchUrls,
  breadcrumb,
  thumbnail,
  requiresAuth = false,
  requiredRoles = [],
} = Astro.props

const authEnabled = import.meta.env.PUBLIC_AUTH_ENABLED === 'true'
const isProtected = authEnabled && requiresAuth


const showTabs = projects.length > 1
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path)
const canonicalUrl = Astro.site ? absolute(Astro.url.pathname) : undefined
const thumbnailUrl = absolute(thumbnail ?? `${Astro.url.pathname.replace(/\/$/, '')}/thumbnail.png`)

const appUrlOverrides = {
  website: import.meta.env.PUBLIC_WEBSITE_URL,
  docs: import.meta.env.PUBLIC_DOCS_URL,
}
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={siteConfig.ogType} />
    <meta name="twitter:card" content={siteConfig.twitterCard} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={thumbnailUrl} />
    <title>{formatTitle(siteConfig, title)}</title>

    <ClientRouter />
    <script is:inline>
      (() => {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })()
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        if (!window.location.hash) {
          window.scrollTo({ top: 0 })
        }
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })
    </script>
    <style define:vars={{ headerHeight: showTabs ? '6rem' : '3.5rem' }}>
      :root {
        --header-height: var(--headerHeight);
      }
    </style>
  </head>
  <body class="min-h-screen antialiased">
    <Header
      projects={projects}
      currentProject={currentProject}
      currentVersion={currentVersion}
      currentLocale={currentLocale}
      locales={locales}
      projectSwitchUrls={projectSwitchUrls}
      versionSwitchUrls={versionSwitchUrls}
      localeSwitchUrls={localeSwitchUrls}
      navItems={navItems}
      currentPath={currentPath}
      appUrlOverrides={appUrlOverrides}
      authEnabled={authEnabled}
      client:load
      transition:persist
      transition:animate="none"
    />
    <div id="docs-nav-data" data-items={JSON.stringify(navItems)} hidden />
    <div class="flex max-w-350 mx-auto">
      <div class="hidden lg:block w-64 shrink-0 border-r h-[calc(100vh-var(--header-height))] overflow-y-auto sticky top-(--header-height) py-6 pl-4 sm:pl-6 pr-4" transition:persist transition:animate="none">
        <Sidebar items={navItems} currentPath={currentPath} authEnabled={authEnabled} client:load />
      </div>
      <main class="flex-1 min-w-0 px-5 sm:px-8 lg:px-12 py-8 lg:py-10" transition:animate="none">
        <div class="mx-auto max-w-4xl">
        {breadcrumb.length > 1 && (
          <nav class="flex items-center gap-1.5 text-sm text-primary mb-4">
            {breadcrumb.slice(0, -1).map((item, i) => (
              <>
                {i > 0 && <span class="text-muted-foreground">/</span>}
                {item.href ? (
                  <a href={item.href} class="hover:underline">{item.title}</a>
                ) : (
                  <span>{item.title}</span>
                )}
              </>
            ))}
          </nav>
        )}
        {isProtected ? (
          <>
            <AuthGate
              requiredRoles={requiredRoles}
              contentId="protected-doc"
              forbiddenId="forbidden-content"
              client:only="react"
            />
            <article id="protected-doc" hidden class="prose prose-neutral dark:prose-invert max-w-none [&>*:first-child]:mt-0">
              <slot />
            </article>
            <div id="forbidden-content" hidden class="flex flex-col items-center justify-center px-6 text-center py-20">
              <NotFoundContent />
            </div>
          </>
        ) : (
          <article class="prose prose-neutral dark:prose-invert max-w-none [&>*:first-child]:mt-0" data-pagefind-body>
            <slot />
          </article>
        )}
        <Pagination prev={prev} next={next} client:load />
        <Footer config={siteConfig} locale={currentLocale} appUrlOverrides={appUrlOverrides} client:load />
        </div>
      </main>
      <div transition:animate="none">
        <TableOfContents headings={headings} client:load />
      </div>
    </div>
  </body>
</html>
