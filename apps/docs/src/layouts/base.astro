---
import '../styles/globals.css'
import { ClientRouter } from 'astro:transitions'
import { formatTitle } from '@ferristrace/config'
import { siteConfig } from '../config'

interface Props {
  title: string
  description?: string
  thumbnail?: string
}

const { title, description, thumbnail } = Astro.props
const thumbnailUrl = thumbnail ?? siteConfig.thumbnail
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Four sizes of the mark; the browser takes the nearest one above the
        slot it is filling. siteConfig.favicon is the 512, the one anything
        that ignores `sizes` falls back to. */}
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
    <link rel="icon" type="image/png" sizes="512x512" href={siteConfig.favicon} />
    <link rel="icon" type="image/png" sizes="1024x1024" href="/favicon-1024.png" />
    <link rel="icon" type="image/png" sizes="2048x2048" href="/favicon-2048.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description ?? siteConfig.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? siteConfig.description} />
    {thumbnailUrl && <meta property="og:image" content={thumbnailUrl} />}
    <meta property="og:type" content={siteConfig.ogType} />
    <meta name="twitter:card" content={siteConfig.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? siteConfig.description} />
    {thumbnailUrl && <meta name="twitter:image" content={thumbnailUrl} />}
    <title>{formatTitle(siteConfig, title)}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })()
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/)
        var theme = match ? match[1] : 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })
    </script>
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <slot />
  </body>
</html>
